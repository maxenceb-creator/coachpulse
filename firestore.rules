rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffPath(uid) {
      return /databases/$(database)/documents/staff_members/$(uid);
    }

    function staffExists() {
      return signedIn() && exists(staffPath(request.auth.uid));
    }

    function staffDoc() {
      return get(staffPath(request.auth.uid));
    }

    function staffStatus() {
      let profile = staffDoc().data;
      return staffExists() && profile.keys().hasAny(['status']) ? profile.status : 'ACTIVE';
    }

    function hasActiveStaffProfile() {
      return staffExists() && !(staffStatus() in ['ARCHIVED', 'INACTIVE', 'DISABLED']);
    }

    function role() {
      let profile = staffDoc().data;
      return hasActiveStaffProfile() && profile.keys().hasAny(['role']) ? profile.role : 'NONE';
    }

    function hasRole(roles) {
      return hasActiveStaffProfile() && role() in roles;
    }

    function permissionLevel() {
      let profile = staffDoc().data;
      return hasActiveStaffProfile() && profile.keys().hasAny(['permissionLevel']) ? profile.permissionLevel : legacyPermissionFromRole();
    }

    function legacyPermissionFromRole() {
      return role() == 'ADMIN' ? 'ADMIN'
        : (role() in ['RESPONSABLE', 'RESPONSABLE_CATEGORIE'] ? 'EDITEUR'
        : (role() in ['LECTURE', 'LECTURE_SEULE', 'OBSERVATEUR', 'OBSERVATEUR_STAFF', 'JOUEUSE_PARENT'] ? 'LECTEUR' : 'SAISIE'));
    }

    function canReadData() {
      return hasActiveStaffProfile() && permissionLevel() in ['LECTEUR', 'SAISIE', 'EDITEUR', 'ADMIN'];
    }

    function canWriteData() {
      return hasActiveStaffProfile() && permissionLevel() in ['SAISIE', 'EDITEUR', 'ADMIN'];
    }

    function canEditData() {
      return hasActiveStaffProfile() && permissionLevel() in ['EDITEUR', 'ADMIN'];
    }

    function canAccessModule(moduleId) {
      let modules = profileList('allowedModules');
      return hasActiveStaffProfile()
        && (
          permissionLevel() == 'ADMIN'
          || role() == 'ADMIN'
          || modules.size() == 0
          || modules.hasAny([moduleId])
        );
    }

    function moduleScopeAllowsAllPlayers(moduleId) {
      return permissionLevel() == 'ADMIN'
        || role() == 'ADMIN'
        || (
          staffDoc().data.keys().hasAny(['moduleScopes'])
          && staffDoc().data.moduleScopes is map
          && staffDoc().data.moduleScopes.keys().hasAny([moduleId])
          && staffDoc().data.moduleScopes[moduleId] is map
          && staffDoc().data.moduleScopes[moduleId].keys().hasAny(['allPlayers'])
          && staffDoc().data.moduleScopes[moduleId].allPlayers == true
        );
    }

    function hasAnyAllPlayersModuleScope() {
      return moduleScopeAllowsAllPlayers('stats')
        || moduleScopeAllowsAllPlayers('presences')
        || moduleScopeAllowsAllPlayers('tests')
        || moduleScopeAllowsAllPlayers('tests-athletiques')
        || moduleScopeAllowsAllPlayers('medical')
        || moduleScopeAllowsAllPlayers('playerProfile')
        || moduleScopeAllowsAllPlayers('teamProfile');
    }

    function canManageUsers() {
      return canEditData() && canAccessModule('admin');
    }

    function canManageCoreData() {
      return canEditData() && (canAccessModule('database') || canAccessModule('dataHub'));
    }

    function canDeleteCoreData(data) {
      return canManageCoreData() && canAccessScopedData(data);
    }

    function canWriteSportData() {
      return canWriteData();
    }

    function canWritePhysicalData() {
      return canWriteData();
    }

    function canReadMedicalData() {
      return canReadData() && canAccessModule('medical');
    }

    function canReadPlayerProfileData(data) {
      return canReadData() && canAccessModule('playerProfile') && canAccessScopedData(data);
    }

    function canWriteMedicalData() {
      return canWriteData() && canAccessModule('medical');
    }

    function profileList(field) {
      let profile = staffDoc().data;
      return profileListFrom(profile, field);
    }

    function profileListFrom(profile, field) {
      return profile.keys().hasAny([field]) && profile[field] is list ? profile[field] : [];
    }

    function authorizedTeams() {
      let profile = staffDoc().data;
      return profileListFrom(profile, 'authorizedTeamIds')
        .concat(profileListFrom(profile, 'teamIds'))
        .concat(profileListFrom(profile, 'allowedTeamIds'))
        .concat(profileListFrom(profile, 'authorizedTeams'))
        .concat(profileListFrom(profile, 'equipesAutorisees'));
    }

    function hasTeamScope() {
      return authorizedTeams().size() > 0;
    }

    function canAccessTeam(teamId) {
      return permissionLevel() == 'ADMIN'
        || authorizedTeams().hasAny([teamId]);
    }

    function canAccessTeamList(teamIds) {
      return permissionLevel() == 'ADMIN'
        || (
          teamIds is list
          && teamIds.hasAny(authorizedTeams())
        );
    }

    function hasPlayerScope() {
      return profileList('playerIds').size() > 0 || profileList('allowedPlayerIds').size() > 0;
    }

    function canAccessPlayerId(playerId) {
      let playerIds = profileList('playerIds');
      let allowedPlayerIds = profileList('allowedPlayerIds');
      return permissionLevel() == 'ADMIN'
        || playerIds.size() == 0 && allowedPlayerIds.size() == 0
        || playerIds.hasAny([playerId])
        || allowedPlayerIds.hasAny([playerId]);
    }

    function valueOrEmpty(data, key) {
      return data.keys().hasAny([key]) ? data[key] : '';
    }

    function canAccessLinkedDocument(collection, documentId) {
      let path = /databases/$(database)/documents/$(collection)/$(documentId);
      return documentId != ''
        && exists(path)
        && canAccessTeamList(scopedTeams(get(path).data));
    }

    function hasScopeFields(data) {
      return data.keys().hasAny(['teamId', 'teamIds', 'rosterTeamIds']);
    }

    function scopedTeams(data) {
      return [valueOrEmpty(data, 'teamId')]
        .concat(data.keys().hasAny(['teamIds']) && data.teamIds is list ? data.teamIds : [])
        .concat(data.keys().hasAny(['rosterTeamIds']) && data.rosterTeamIds is list ? data.rosterTeamIds : []);
    }

    function canAccessDirectData(data) {
      return permissionLevel() == 'ADMIN'
        || (hasScopeFields(data) && canAccessTeamList(scopedTeams(data)));
    }

    function canAccessScopedData(data) {
      return canAccessDirectData(data)
        || (data.keys().hasAny(['playerId']) && canAccessLinkedDocument('players', data.playerId));
    }

    function canAccessMatchScopedData(data) {
      return canAccessScopedData(data)
        || (data.keys().hasAny(['matchId']) && canAccessLinkedDocument('matches', data.matchId));
    }

    function canAccessSessionScopedData(data) {
      return canAccessScopedData(data)
        || (data.keys().hasAny(['sessionId']) && canAccessLinkedDocument('sessions', data.sessionId));
    }

    function canAccessMatchScopedDataForModule(data, moduleId) {
      return canAccessMatchScopedData(data) || moduleScopeAllowsAllPlayers(moduleId);
    }

    function canAccessSessionScopedDataForModule(data, moduleId) {
      return canAccessSessionScopedData(data) || moduleScopeAllowsAllPlayers(moduleId);
    }

    function canAccessScopedDataForModule(data, moduleId) {
      return canAccessScopedData(data) || moduleScopeAllowsAllPlayers(moduleId);
    }

    function isPresenceSession(data) {
      return (
          data.keys().hasAny(['createdFromPresenceModule'])
          && data.createdFromPresenceModule == true
        )
        || (
          data.keys().hasAny(['source'])
          && data.source == 'Présences'
        );
    }

    function isRetiredPresenceImportSessionId(sessionId) {
      return sessionId.matches('xlsx-2025-.*')
        || sessionId.matches('xlsx-2026-0[1-6]-.*');
    }

    function canDeleteRetiredPresenceImportSession(sessionId, data) {
      return (permissionLevel() == 'ADMIN' || role() == 'ADMIN')
        && canAccessModule('presences')
        && isRetiredPresenceImportSessionId(sessionId)
        && canAccessScopedDataForModule(data, 'presences');
    }

    function canDeletePresenceSession(data) {
      return canWriteSportData()
        && canAccessModule('presences')
        && isPresenceSession(data)
        && canAccessScopedDataForModule(data, 'presences');
    }

    function canReadPlayerDoc(playerId, data) {
      return canReadData()
        && canAccessPlayerId(playerId)
        && canAccessDirectData(data);
    }

    function noDelete() {
      return false;
    }

    function isAllowedSelfStaffMaintenance(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastLoginAt', 'email']);
    }

    match /staff_members/{uid} {
      allow read: if canManageUsers() || (signedIn() && request.auth.uid == uid);
      allow create: if canManageUsers()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role in ['RESPONSABLE_POLE', 'ENTRAINEUR', 'ENTRAINEUR_ADJOINT', 'PREPARATEUR_PHYSIQUE', 'KINE', 'MEDECIN', 'DIRIGEANT', 'EDUCATEUR', 'COACH', 'LECTURE', 'OBSERVATEUR_STAFF']
          && request.resource.data.permissionLevel in ['LECTEUR', 'SAISIE', 'EDITEUR']
          && request.resource.data.status == 'ACTIVE'
        );
      allow update: if canManageUsers() || isAllowedSelfStaffMaintenance(uid);
      allow delete: if noDelete();
    }

    match /coachpulse_common_base/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow delete: if noDelete();
    }

    match /players/{playerId} {
      allow read: if (canReadPlayerDoc(playerId, resource.data) && (canAccessModule('database') || canAccessModule('playerProfile') || canAccessModule('presences')))
        || (canReadData() && canAccessPlayerId(playerId) && hasAnyAllPlayersModuleScope());
      allow create: if canManageCoreData()
        && canAccessModule('database')
        && request.resource.data.playerId == playerId
        && request.resource.data.status in ['ACTIVE', 'ARCHIVED', 'active', 'injured', 'left', 'archived']
        && canAccessDirectData(request.resource.data);
      allow update: if canManageCoreData()
        && canAccessModule('database')
        && resource.data.playerId == playerId
        && request.resource.data.playerId == playerId
        && request.resource.data.status in ['ACTIVE', 'ARCHIVED', 'active', 'injured', 'left', 'archived']
        && canAccessDirectData(resource.data)
        && canAccessDirectData(request.resource.data);
      allow delete: if canWriteSportData() && canAccessModule('tests')
        && (canAccessDirectData(resource.data) || moduleScopeAllowsAllPlayers('tests'));
    }

    match /teams/{teamId} {
      allow read: if canReadData() && canAccessTeam(teamId);
      allow create, update: if canManageCoreData()
        && request.resource.data.teamId == teamId
        && canAccessTeam(teamId);
      allow delete: if noDelete();
    }

    match /settings/{settingsId} {
      allow read: if canReadData();
      allow create, update: if settingsId == 'presence-module'
        ? (permissionLevel() == 'ADMIN' || role() == 'ADMIN')
        : canManageCoreData();
      allow delete: if noDelete();
    }

    match /changeLogs/{changeLogId} {
      allow read: if canManageCoreData();
      allow create: if canManageCoreData();
      allow update, delete: if noDelete();
    }

    match /syncLogs/{syncLogId} {
      allow read: if canManageCoreData();
      allow create: if canManageCoreData();
      allow update, delete: if noDelete();
    }

    match /matches/{matchId} {
      allow read: if canReadData()
        && (canAccessModule('stats') || canAccessModule('playerProfile'))
        && canAccessDirectData(resource.data);
      allow create: if canWriteSportData() && canAccessModule('stats') && canAccessDirectData(request.resource.data);
      allow update: if canWriteSportData() && canAccessModule('stats') && canAccessDirectData(resource.data) && canAccessDirectData(request.resource.data);
      allow delete: if noDelete();
    }

    match /matchEvents/{eventId} {
      allow read: if (canReadData() && canAccessModule('stats') && canAccessMatchScopedData(resource.data))
        || (canReadData() && canAccessModule('playerProfile') && canAccessMatchScopedData(resource.data));
      allow create: if canWriteSportData() && canAccessModule('stats') && canAccessMatchScopedData(request.resource.data);
      allow update: if canWriteSportData() && canAccessModule('stats') && canAccessMatchScopedData(resource.data) && canAccessMatchScopedData(request.resource.data);
      allow delete: if canWriteSportData() && canAccessModule('stats') && canAccessMatchScopedDataForModule(resource.data, 'stats');
    }

    match /sessions/{sessionId} {
      allow read: if (
          canReadData()
          && (
            (canAccessModule('methodologie') && canAccessDirectData(resource.data))
            || (canAccessModule('presences') && isPresenceSession(resource.data) && (canAccessDirectData(resource.data) || moduleScopeAllowsAllPlayers('presences')))
            || (canAccessModule('presences') && isRetiredPresenceImportSessionId(sessionId) && (canAccessDirectData(resource.data) || moduleScopeAllowsAllPlayers('presences')))
          )
        ) || (canReadData() && canAccessModule('playerProfile') && canAccessDirectData(resource.data));
      allow create: if canWriteSportData()
        && !exists(/databases/$(database)/documents/presenceDeletionLogs/$(sessionId))
        && (
          (canAccessModule('methodologie') && canAccessDirectData(request.resource.data))
          || (canAccessModule('presences') && isPresenceSession(request.resource.data) && (canAccessDirectData(request.resource.data) || moduleScopeAllowsAllPlayers('presences')))
        );
      allow update: if canWriteSportData()
        && (
          (canAccessModule('methodologie') && canAccessDirectData(resource.data) && canAccessDirectData(request.resource.data))
          || (canAccessModule('presences') && isPresenceSession(resource.data) && isPresenceSession(request.resource.data)
            && (canAccessDirectData(resource.data) || moduleScopeAllowsAllPlayers('presences'))
            && (canAccessDirectData(request.resource.data) || moduleScopeAllowsAllPlayers('presences')))
        );
      allow delete: if canDeletePresenceSession(resource.data)
        || canDeleteRetiredPresenceImportSession(sessionId, resource.data);
    }

    match /attendance/{attendanceId} {
      allow read: if (canReadData() && canAccessModule('presences') && canAccessSessionScopedDataForModule(resource.data, 'presences'))
        || (canReadData() && canAccessModule('playerProfile') && canAccessSessionScopedData(resource.data));
      allow create: if canWriteSportData()
        && canAccessModule('presences')
        && canAccessSessionScopedDataForModule(request.resource.data, 'presences')
        && request.resource.data.keys().hasAny(['sessionId'])
        && !exists(/databases/$(database)/documents/presenceDeletionLogs/$(request.resource.data.sessionId));
      allow update: if canWriteSportData() && canAccessModule('presences') && canAccessSessionScopedDataForModule(resource.data, 'presences') && canAccessSessionScopedDataForModule(request.resource.data, 'presences');
      allow delete: if (
          canWriteSportData()
          && canAccessModule('presences')
          && canAccessSessionScopedDataForModule(resource.data, 'presences')
        ) || canDeleteCoreData(resource.data);
    }

    match /presenceDeletionLogs/{deletionId} {
      allow get: if canReadData() && canAccessModule('presences');
      allow list: if canReadData()
        && canAccessModule('presences')
        && canAccessScopedDataForModule(resource.data, 'presences');
      allow create: if canWriteSportData()
        && canAccessModule('presences')
        && canAccessScopedDataForModule(request.resource.data, 'presences');
      allow update, delete: if noDelete();
    }

    match /technicalTests/{testId} {
      allow read: if (canReadData() && canAccessModule('tests') && canAccessScopedDataForModule(resource.data, 'tests')) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteSportData() && canAccessModule('tests') && canAccessScopedDataForModule(request.resource.data, 'tests');
      allow update: if canWriteSportData() && canAccessModule('tests') && canAccessScopedDataForModule(resource.data, 'tests') && canAccessScopedDataForModule(request.resource.data, 'tests');
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /physicalTests/{testId} {
      allow read: if (canReadData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques')) || canReadPlayerProfileData(resource.data);
      allow create: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(request.resource.data, 'tests-athletiques');
      allow update: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques') && canAccessScopedDataForModule(request.resource.data, 'tests-athletiques');
      allow delete: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques');
    }

    match /physicalTestDeletions/{testId} {
      allow read: if canReadData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques');
      allow create: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(request.resource.data, 'tests-athletiques');
      allow update: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques') && canAccessScopedDataForModule(request.resource.data, 'tests-athletiques');
      allow delete: if canWritePhysicalData() && (canAccessModule('tests-athletiques') || canAccessModule('tests')) && canAccessScopedDataForModule(resource.data, 'tests-athletiques');
    }

    match /playerMeasurements/{measurementId} {
      allow read: if canReadData() && (canAccessModule('playerProfile') || canAccessModule('medical')) && canAccessScopedData(resource.data);
      allow create: if canWriteData() && (canAccessModule('playerProfile') || canAccessModule('medical')) && canAccessScopedData(request.resource.data)
        && request.resource.data.playerId is string && request.resource.data.playerId.size() > 0
        && request.resource.data.teamId is string && request.resource.data.teamId.size() > 0
        && request.resource.data.measuredAt is string && request.resource.data.measuredAt.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.heightCm is number && request.resource.data.heightCm >= 80 && request.resource.data.heightCm <= 230
        && request.resource.data.weightKg is number && request.resource.data.weightKg >= 15 && request.resource.data.weightKg <= 200;
      allow update: if canWriteData() && (canAccessModule('playerProfile') || canAccessModule('medical')) && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data)
        && request.resource.data.playerId == resource.data.playerId && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.measuredAt is string && request.resource.data.measuredAt.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.heightCm is number && request.resource.data.heightCm >= 80 && request.resource.data.heightCm <= 230
        && request.resource.data.weightKg is number && request.resource.data.weightKg >= 15 && request.resource.data.weightKg <= 200;
      allow delete: if canEditData() && canAccessModule('playerProfile') && canAccessScopedData(resource.data);
    }

    match /injuries/{recordId} {
      allow read: if (canReadMedicalData() && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteMedicalData() && canAccessScopedData(request.resource.data);
      allow update: if canWriteMedicalData() && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /injuryUpdates/{recordId} {
      allow read: if (canReadMedicalData() && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteMedicalData() && canAccessScopedData(request.resource.data);
      allow update: if canWriteMedicalData() && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /medicalAppointments/{recordId} {
      allow read: if (canReadMedicalData() && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteMedicalData() && canAccessScopedData(request.resource.data);
      allow update: if canWriteMedicalData() && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /rehabRoutines/{recordId} {
      allow read: if (canReadMedicalData() && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteMedicalData() && canAccessScopedData(request.resource.data);
      allow update: if canWriteMedicalData() && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /medicalFollowUps/{recordId} {
      allow read: if (canReadMedicalData() && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteMedicalData() && canAccessScopedData(request.resource.data);
      allow update: if canWriteMedicalData() && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /workloads/{workloadId} {
      allow read: if (canReadData() && canAccessModule('workload') && canAccessSessionScopedData(resource.data))
        || (canReadData() && canAccessModule('playerProfile') && canAccessSessionScopedData(resource.data));
      allow create: if canWritePhysicalData() && canAccessModule('workload') && canAccessSessionScopedData(request.resource.data);
      allow update: if canWritePhysicalData() && canAccessModule('workload') && canAccessSessionScopedData(resource.data) && canAccessSessionScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /convocations/{convocationId} {
      allow read: if (canReadData() && canAccessModule('convocations') && canAccessMatchScopedData(resource.data))
        || (canReadData() && canAccessModule('playerProfile') && canAccessMatchScopedData(resource.data));
      allow create: if canWriteSportData() && canAccessModule('convocations') && canAccessMatchScopedData(request.resource.data);
      allow update: if canWriteSportData() && canAccessModule('convocations') && canAccessMatchScopedData(resource.data) && canAccessMatchScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /individualReports/{reportId} {
      allow read: if (canReadData() && canAccessModule('individualReports') && canAccessScopedData(resource.data)) || canReadPlayerProfileData(resource.data);
      allow create: if canWriteSportData() && canAccessModule('individualReports') && canAccessScopedData(request.resource.data);
      allow update: if canWriteSportData() && canAccessModule('individualReports') && canAccessScopedData(resource.data) && canAccessScopedData(request.resource.data);
      allow delete: if canDeleteCoreData(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
